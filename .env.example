# Copy to .env for local use. On Vercel, set these in Project → Settings → Environment Variables.
# Never commit real values.

# Team passcode. When set, people must enter it once before the company data loads.
# Leave unset and anyone with the link can open the tool.
FINDER_PASSCODE=

# Where the "Feedback" button sends email. Leave unset and the button only offers "Copy".
FEEDBACK_EMAIL=
